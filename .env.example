# =============================================================================
# 必須設定
# =============================================================================

# OpenAI API キー（URLからのレシピ取り込み機能に必要）
# https://platform.openai.com/api-keys で取得
NINA_NJAA_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TypeSafe AI (Jev) の API キー（レシピの自動カテゴリ分類機能に必要）
# https://console.typesafe.ai で取得
TYPESAFE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google ログイン（OAuth クライアント ID / シークレット）
# https://console.cloud.google.com/apis/credentials で「ウェブ アプリケーション」として作成
NINA_NJAA_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
NINA_NJAA_GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Google に登録した「承認済みのリダイレクト URI」と完全一致させる
NINA_NJAA_GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ログインを許可する Google アカウントと、ログイン後のユーザー名（カンマ区切り）
# ユーザー名はブックマーク・履歴などの紐付けに使う
NINA_NJAA_GOOGLE_ALLOWED_ACCOUNTS=me@gmail.com=admin

# JWT 認証のシークレットキー（32文字以上のランダム文字列）
NINA_NJAA_JWT_SECRET_KEY=hogefuga

# =============================================================================
# 任意設定（デフォルト値あり）
# =============================================================================

# Secure Cookie を使用するかどうか（デフォルト: false）
NINA_NJAA_SECURE_COOKIE=false

# CloudFront の署名付き URL を使用する場合のシークレットキー（デフォルト: 空文字）
NINA_NJAA_CLOUDFRONT_SECRET=****************